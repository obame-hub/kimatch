# Variables d'environnement de Kimatch.
#
# Ce fichier n'en declarait que TROIS alors que le code en lit vingt-six — constat de l'audit du
# 28/08/2026. Une installation neuve echouait donc sans qu'on sache sur quoi. Aucune valeur reelle
# ici : ce sont des noms et ce qu'ils attendent. Les vraies valeurs vivent dans .env.local en local
# (jamais commite) et dans les variables d'environnement Vercel en ligne.

# ── Navigateur ────────────────────────────────────────────────────────────────────────────────
# Les seules variables VITE_* : elles partent dans le bundle, donc rien de secret ici. La cle anon
# est publique par construction et protegee par les politiques RLS.
VITE_SUPABASE_URL=https://llktvzbbfadmnhfjatrh.supabase.co
VITE_SUPABASE_ANON_KEY=
# A definir UNIQUEMENT sur le deploiement sandbox : affiche un bandeau permanent pour ne jamais
# confondre les deux environnements. Vide en production.
VITE_ENV_LABEL=
# Adresse du deploiement sandbox, pour le lien depuis l'ecran Administration.
VITE_SANDBOX_URL=

# ── Serveur : base de donnees ─────────────────────────────────────────────────────────────────
# Contourne les politiques RLS. N'existe QUE cote serveur, jamais dans le bundle.
SUPABASE_SERVICE_ROLE_KEY=
# Chaine de connexion Postgres directe (contient le mot de passe). Sert aux migrations lancees
# depuis un poste, via scripts/appliquer-migration.cjs. Absente de Vercel.
SUPABASE_DB_URL=

# ── Serveur : taches planifiees ───────────────────────────────────────────────────────────────
# La vraie barriere des trois crons. L'en-tete x-vercel-cron n'en est PAS une : n'importe qui peut
# la poser sur une requete. Quand CRON_SECRET est definie, Vercel l'envoie lui-meme en
# Authorization: Bearer sur ses invocations planifiees, et on n'accepte plus que ca.
CRON_SECRET=

# ── DocuSign (signature des mandats et des contrats) ──────────────────────────────────────────
# Application « Kiwee Lovable Mandats ». La connexion est faite PAR UTILISATEUR (OAuth) depuis
# Mon profil : ces variables identifient l'application, pas une personne.
DOCUSIGN_INTEGRATION_KEY=
DOCUSIGN_SECRET_KEY=
DOCUSIGN_ACCOUNT_ID=
DOCUSIGN_BASE_URL=
DOCUSIGN_OAUTH_REDIRECT_URI=
# Secret HMAC de DocuSign Connect. Sans lui, le webhook accepterait n'importe quel appel : il
# verifie la signature en comparaison a temps constant avant de toucher a un mandat.
DOCUSIGN_CONNECT_HMAC_SECRET=
# Profil dont le compte Gmail envoie la notification d'envoi de mandat.
MANDAT_EMAIL_SENDER_PROFIL=

# ── Ellisphere (score de solvabilite des entreprises) ─────────────────────────────────────────
# Service facture a l'usage. Les fonctions /api/ellisphere/* exigent une session depuis le
# 28/08/2026 : sans cela, un tiers consommait le budget.
ELLISPHERE_USER_ID=
ELLISPHERE_PASSWORD=
ELLISPHERE_CONTRACT_ID=
ELLISPHERE_USER_PREFIX=

# ── Enedis (donnees de comptage electricite) ──────────────────────────────────────────────────
# Certificat client au format PEM, sur une seule ligne avec des \n litteraux. Ce couple donne
# acces aux donnees de comptage de N'IMPORTE QUEL PDL : /api/enedis/* exige une session depuis le
# 28/08/2026.
ENEDIS_LOGIN=
ENEDIS_CONTRAT_ID=
ENEDIS_CERT_PEM=
ENEDIS_KEY_PEM=

# ── GRD gaz ───────────────────────────────────────────────────────────────────────────────────
WATTELSE_LOGIN=
WATTELSE_PASSWORD=

# ── Extraction de documents (OCR des factures, contrats, mandats) ─────────────────────────────
# API Anthropic, facturee a l'usage. /api/ocr/extract-document exige une session depuis le 28/08.
ANTHROPIC_API_KEY=

# ── Slack (notifications d'equipe) ────────────────────────────────────────────────────────────
# Jeton de bot. Les canaux se choisissent depuis l'ecran Parametres.
SLACK_BOT_TOKEN=

# ── Pilot (remontee des demandes de support) ──────────────────────────────────────────────────
PILOT_BASE_URL=
PILOT_API_KEY=

# ── Sandbox (recopie de la production vers un second projet Supabase) ─────────────────────────
# A definir uniquement sur le deploiement qui pilote la recopie.
SANDBOX_SUPABASE_URL=
SANDBOX_SUPABASE_SERVICE_ROLE_KEY=
