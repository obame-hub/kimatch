{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "regions": ["cdg1"],
  "redirects": [
    {
      "source": "/((?!api/).*)",
      "has": [{ "type": "host", "value": "kiwee-os.vercel.app" }],
      "destination": "https://kimatch.fr/$1",
      "permanent": false
    }
  ],
  "rewrites": [
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Strict-Transport-Security", "value": "max-age=31536000; includeSubDomains" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=()" },
        {
          "key": "Content-Security-Policy-Report-Only",
          "value": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: blob: https://*.supabase.co; connect-src 'self' https://*.supabase.co wss://*.supabase.co https://api-adresse.data.gouv.fr https://recherche-entreprises.api.gouv.fr https://tabular-api.data.gouv.fr; worker-src 'self' blob:; frame-src 'self' https://www.youtube.com; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'"
        }
      ]
    }
  ],
  "crons": [
    {
      "path": "/api/docusign/refresh-sessions",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/api/docusign/rattraper-enveloppes",
      "schedule": "0 7-20 * * *"
    },
    {
      "path": "/api/mandats/expirer",
      "schedule": "15 3 * * *"
    },
    {
      "path": "/api/comptes/photographier-qualite",
      "schedule": "30 3 * * *"
    },
    {
      "path": "/api/contrats/reevaluer-statuts",
      "schedule": "45 3 * * *"
    },
    {
      "path": "/api/signaux/echeances",
      "schedule": "30 3 * * *"
    }
  ]
}
